                    body.put("email", emailValue);
                    body.put("password", passwordValue);
                } catch (Exception ignored) {}
                api.post("/auth/login", null, body, new ApiClient.Callback() {
                    @Override public void onSuccess(final JSONObject json) {
                        runOnUiThread(new Runnable() {
                            @Override public void run() {
                                String access = json.optString("access_token", "");
                                if (!access.isEmpty()) {
                                    persistAndEnter(access);
                                    return;
                                }
                                if (json.optBoolean("needs_store_selection", false)) {
                                    String ticket = json.optString("selection_ticket", "");
                                    JSONArray stores = json.optJSONArray("stores");
                                    if (!ticket.isEmpty() && stores != null && stores.length() > 0) {
                                        showStoreSelection(ticket, stores);
                                        return;
                                    }
                                }
                                submit.setEnabled(true);
                                submit.setText("Entrar");
                                errorText.setText("La API no devolvió una sesión utilizable.");
                                errorText.setVisibility(View.VISIBLE);
                            }
                        });
                    }
                    @Override public void onError(final ApiClient.ApiException error) {
                        runOnUiThread(new Runnable() {
                            @Override public void run() {
                                submit.setEnabled(true);
                                submit.setText("Entrar");
                                errorText.setText(error.getMessage());
                                errorText.setVisibility(View.VISIBLE);
                            }
                        });
                    }
                });
            }
        });
        setContentView(scroll);
    }

    private void persistAndEnter(String access) {
        try {
            tokenStore.save(access);
            bearer = access;
            validateSession();
        } catch (Exception error) {
            tokenStore.clear();
            bearer = null;
            showLogin("No se pudo proteger la sesión en este dispositivo.");
        }
    }

    private void showStoreSelection(final String ticket, JSONArray stores) {
        ScrollView scroll = new ScrollView(this);
        scroll.setFillViewport(true);
        scroll.setBackgroundColor(BG);
        LinearLayout wrap = new LinearLayout(this);
        wrap.setOrientation(LinearLayout.VERTICAL);
        wrap.setPadding(dp(22), dp(34), dp(22), dp(32));
        scroll.addView(wrap);

        TextView top = eyebrow("DEZGRE · TIENDAS");
        wrap.addView(top);
        wrap.addView(gap(8));
        wrap.addView(text("Selecciona tu tienda", 29, TEXT, true));
        wrap.addView(gap(7));
        wrap.addView(text("Tu usuario tiene acceso a varias tiendas. Elige con cuál quieres trabajar en esta sesión.", 14, MUTED, false));
        wrap.addView(gap(22));

        for (int i = 0; i < stores.length(); i++) {
            final JSONObject store = stores.optJSONObject(i);
            if (store == null) continue;
            LinearLayout storeCard = card();
            LinearLayout topRow = new LinearLayout(this);
            topRow.setOrientation(LinearLayout.HORIZONTAL);
            topRow.setGravity(Gravity.CENTER_VERTICAL);
            TextView avatar = text(safeInitial(store.optString("name", "Tienda")), 18, Color.WHITE, true);
            avatar.setGravity(Gravity.CENTER);
            avatar.setBackground(rounded(ACCENT, Color.TRANSPARENT, 10));
            topRow.addView(avatar, new LinearLayout.LayoutParams(dp(44), dp(44)));
            LinearLayout identity = new LinearLayout(this);
            identity.setOrientation(LinearLayout.VERTICAL);
            identity.setPadding(dp(12), 0, 0, 0);
            identity.addView(text(store.optString("name", "Tienda"), 18, TEXT, true));
            identity.addView(gap(3));
            identity.addView(text(store.optString("role", ""), 12, ACCENT, true));
            topRow.addView(identity, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
            TextView chevron = text("›", 28, MUTED, false);
            chevron.setGravity(Gravity.CENTER);
            topRow.addView(chevron, new LinearLayout.LayoutParams(dp(32), dp(44)));
            storeCard.addView(topRow);
            String domain = store.optString("domain", "");
            if (!domain.isEmpty() && !"null".equals(domain)) {
                storeCard.addView(gap(10));
                storeCard.addView(text(domain, 12, MUTED, false));
            }
            storeCard.setClickable(true);
            storeCard.setForeground(getDrawable(android.R.drawable.list_selector_background));
            storeCard.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View v) {
                    final long storeId = store.optLong("id", -1);
                    if (storeId <= 0) return;
                    setContentView(loadingScreen("Abriendo " + store.optString("name", "tienda") + "…"));
                    JSONObject payload = new JSONObject();
                    try { payload.put("storeId", storeId); } catch (Exception ignored) {}
                    api.post("/auth/select-store", ticket, payload, new ApiClient.Callback() {
                        @Override public void onSuccess(final JSONObject json) {
                            runOnUiThread(new Runnable() {
                                @Override public void run() {
