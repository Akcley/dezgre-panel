    private void loadProductDetail(final String productId) {
        if (productId.isEmpty()) return;
        setPageHeading("PRODUCTO", "Detalle de producto", "Información disponible mediante Bubble API V1.");
        body.removeAllViews();
        Button back = button("← Volver a productos", false);
        back.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View v) { showMain("products"); }
        });
        body.addView(back);
        body.addView(gap(12));
        body.addView(loadingInline("Cargando detalle…"));
        api.get("/products/" + productId + "?scope=" + currentScope, bearer, new ApiClient.Callback() {
            @Override public void onSuccess(final JSONObject json) {
                runOnUiThread(new Runnable() {
                    @Override public void run() { renderProductDetail(json.optJSONObject("product")); }
                });
            }
            @Override public void onError(ApiClient.ApiException error) { handlePrivateError(error, "No se pudo cargar el producto."); }
        });
    }

    private void renderProductDetail(JSONObject product) {
        body.removeAllViews();
        Button back = button("← Volver a productos", false);
        back.setOnClickListener(new View.OnClickListener() { @Override public void onClick(View v) { showMain("products"); } });
        body.addView(back);
        body.addView(gap(14));
        if (product == null) {
            LinearLayout missing = card();
            missing.addView(text("Producto no disponible.", 16, DANGER, true));
            body.addView(missing);
            return;
        }

        LinearLayout main = card();
        LinearLayout identity = new LinearLayout(this);
        identity.setOrientation(LinearLayout.HORIZONTAL);
        identity.setGravity(Gravity.CENTER_VERTICAL);
        String name = product.optString("name", "Producto");
        TextView thumb = text(safeInitial(name), 28, ACCENT, true);
        thumb.setGravity(Gravity.CENTER);
        thumb.setBackground(rounded(Color.rgb(244, 241, 246), BORDER, 12));
        identity.addView(thumb, new LinearLayout.LayoutParams(dp(84), dp(84)));
        LinearLayout copy = new LinearLayout(this);
        copy.setOrientation(LinearLayout.VERTICAL);
        copy.setPadding(dp(14), 0, 0, 0);
        copy.addView(text(name, 22, TEXT, true));
        String category = product.optString("category", "");
        if (!category.isEmpty() && !"null".equals(category)) {
            copy.addView(gap(4));
            copy.addView(text(category, 12, MUTED, false));
        }
        String sku = product.optString("sku", "");
        if (!sku.isEmpty() && !"null".equals(sku)) {
            copy.addView(gap(3));
            copy.addView(text("SKU " + sku, 11, MUTED, true));
        }
        identity.addView(copy, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        main.addView(identity);
        main.addView(gap(18));

        TextView priceLabel = eyebrow("PRECIO");
        main.addView(priceLabel);
        main.addView(gap(4));
        main.addView(text(price(product.optDouble("price", 0)), 24, SUCCESS, true));
        if (!product.isNull("offerPrice")) {
            main.addView(gap(8));
            main.addView(text("Oferta: " + price(product.optDouble("offerPrice", 0)), 13, TEXT, true));
        }
        if (!product.isNull("threeUnitPrice")) {
            main.addView(gap(3));
            main.addView(text("3 unidades: " + price(product.optDouble("threeUnitPrice", 0)), 13, TEXT, true));
        }
        main.addView(gap(12));
        int stock = product.optInt("stock", 0);
        TextView stockText = text("Stock: " + stock, 13, stock > 0 ? TEXT : DANGER, true);
        main.addView(stockText);
        body.addView(main);

        String description = product.optString("description", "");
        if (!description.isEmpty() && !"null".equals(description)) {
            LinearLayout descriptionCard = card();
            descriptionCard.addView(eyebrow("DESCRIPCIÓN"));
            descriptionCard.addView(gap(8));
            descriptionCard.addView(text(description, 14, TEXT, false));
            body.addView(descriptionCard);
        }

        LinearLayout safety = card();
        safety.addView(text("Solo lectura", 13, ACCENT, true));
        safety.addView(gap(5));
        safety.addView(text("Esta versión consulta información; no modifica productos ni stock.", 12, MUTED, false));
        body.addView(safety);
    }

    private void loadProfile() {
        setPageHeading("MI CUENTA", "Ajustes de cuenta", "Tu perfil, acceso, tiendas y notificaciones.");
        body.removeAllViews();
        body.addView(loadingInline("Cargando tu cuenta…"));
        api.get("/me", bearer, new ApiClient.Callback() {
            @Override public void onSuccess(final JSONObject me) {
                api.get("/stores", bearer, new ApiClient.Callback() {
                    @Override public void onSuccess(final JSONObject stores) {
                        runOnUiThread(new Runnable() {
                            @Override public void run() {
                                applyIdentity(me);
                                renderProfile(me, stores.optJSONArray("stores"));
                            }
                        });
                    }
                    @Override public void onError(ApiClient.ApiException error) { handlePrivateError(error, "No se pudieron cargar tus tiendas."); }
                });
            }
            @Override public void onError(ApiClient.ApiException error) { handlePrivateError(error, "No se pudo cargar tu cuenta."); }
        });
    }