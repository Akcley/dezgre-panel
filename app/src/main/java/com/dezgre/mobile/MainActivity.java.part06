            if (product == null) continue;
            LinearLayout item = card();
            String name = product.optString("name", "Producto");
            item.addView(text(name, 18, TEXT, true));
            String category = product.optString("category", "");
            if (!category.isEmpty() && !"null".equals(category)) {
                item.addView(gap(4));
                item.addView(text(category, 12, MUTED, false));
            }
            item.addView(gap(9));
            LinearLayout meta = new LinearLayout(this);
            meta.setOrientation(LinearLayout.HORIZONTAL);
            meta.addView(text(price(product.optDouble("price", 0)), 16, ACCENT, true), new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
            meta.addView(text("Stock: " + product.optInt("stock", 0), 13, product.optInt("stock", 0) > 0 ? MUTED : DANGER, true));
            item.addView(meta);
            item.setClickable(true);
            item.setForeground(getDrawable(android.R.drawable.list_selector_background));
            item.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View v) { loadProductDetail(product.optString("id", "")); }
            });
            body.addView(item);
        }
    }

    private String price(double amount) {
        return String.format(Locale.US, "S/ %.2f", amount);
    }

    private void loadProductDetail(final String productId) {
        if (productId.isEmpty()) return;
        titleView.setText("Detalle de producto");
        subtitleView.setText("/v1/products/" + productId);
        body.removeAllViews();
        Button back = button("← Volver a productos", false);
        back.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View v) { showMain("products"); }
        });
        body.addView(back);
        body.addView(gap(12));
        body.addView(loadingInline("Cargando detalle…"));
        api.get("/products/" + productId + "?scope=" + currentScope, bearer, new ApiClient.Callback() {
            @Override public void onSuccess(final JSONObject json) {
                runOnUiThread(new Runnable() {
                    @Override public void run() { renderProductDetail(json.optJSONObject("product")); }
                });
            }
            @Override public void onError(ApiClient.ApiException error) { handlePrivateError(error, "No se pudo cargar el producto."); }
        });
    }

    private void renderProductDetail(JSONObject product) {
        body.removeAllViews();
        Button back = button("← Volver a productos", false);
        back.setOnClickListener(new View.OnClickListener() { @Override public void onClick(View v) { showMain("products"); } });
        body.addView(back);
        body.addView(gap(14));
        if (product == null) {
            body.addView(text("Producto no disponible.", 16, DANGER, true));
            return;
        }
        LinearLayout main = card();
        main.addView(text(product.optString("name", "Producto"), 25, TEXT, true));
        main.addView(gap(6));
        String sku = product.optString("sku", "");
        if (!sku.isEmpty() && !"null".equals(sku)) main.addView(text("SKU " + sku, 12, MUTED, true));
        main.addView(gap(14));
        main.addView(text("Precio", 12, MUTED, true));
        main.addView(text(price(product.optDouble("price", 0)), 22, ACCENT, true));
        if (!product.isNull("offerPrice")) {
            main.addView(gap(8));
            main.addView(text("Oferta: " + price(product.optDouble("offerPrice", 0)), 14, TEXT, true));
        }
        if (!product.isNull("threeUnitPrice")) {
            main.addView(text("3 unidades: " + price(product.optDouble("threeUnitPrice", 0)), 14, TEXT, true));
        }
        main.addView(gap(10));
        main.addView(text("Stock: " + product.optInt("stock", 0), 14, product.optInt("stock", 0) > 0 ? TEXT : DANGER, true));
        body.addView(main);
        String description = product.optString("description", "");
        if (!description.isEmpty() && !"null".equals(description)) {
            LinearLayout descriptionCard = card();
            descriptionCard.addView(text("Descripción", 14, MUTED, true));
            descriptionCard.addView(gap(7));
            descriptionCard.addView(text(description, 15, TEXT, false));
            body.addView(descriptionCard);
        }
        LinearLayout safety = card();
        safety.addView(text("Modo lectura", 13, MUTED, true));
        safety.addView(gap(6));
        safety.addView(text("Esta versión no modifica productos ni stock.", 14, TEXT, false));
        body.addView(safety);
    }

    private void loadProfile() {
        titleView.setText("Perfil");
