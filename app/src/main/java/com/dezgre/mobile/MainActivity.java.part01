package com.dezgre.mobile;

import android.app.Activity;
import android.content.Context;
import android.content.Intent;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.os.Bundle;
import android.text.InputType;
import android.view.Gravity;
import android.view.View;
import android.view.ViewGroup;
import android.view.Window;
import android.view.inputmethod.InputMethodManager;
import android.widget.Button;
import android.widget.EditText;
import android.widget.FrameLayout;
import android.widget.HorizontalScrollView;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.ProgressBar;
import android.widget.ScrollView;
import android.widget.Space;
import android.widget.TextView;

import org.json.JSONArray;
import org.json.JSONObject;

import java.util.Locale;

public final class MainActivity extends Activity {
    // Visual tokens mirrored from the responsive DEZGRE web panel.
    private static final int BG = Color.rgb(247, 247, 247);
    private static final int SURFACE = Color.WHITE;
    private static final int TEXT = Color.rgb(48, 55, 79);
    private static final int MUTED = Color.rgb(139, 146, 162);
    private static final int ACCENT = Color.rgb(177, 68, 178);
    private static final int ACCENT_SOFT = Color.rgb(248, 237, 248);
    private static final int SUCCESS = Color.rgb(0, 185, 87);
    private static final int BORDER = Color.rgb(225, 228, 235);
    private static final int DANGER = Color.rgb(180, 35, 24);
    private static final int PANEL_DARK = Color.rgb(17, 17, 19);
    private static final int PANEL_DARK_2 = Color.rgb(27, 27, 29);
    private static final int PANEL_DARK_ACTIVE = Color.rgb(38, 38, 41);

    private ApiClient api;
    private SecureTokenStore tokenStore;
    private String bearer;
    private String currentScope = "bot";
    private String currentTab = "home";
    private String currentStoreId = "";
    private String currentStoreName = "Tienda";
    private String currentUserName = "Usuario";
    private String currentUserRole = "";
    private String currentUserAvatar = "";
    private String pendingNotificationTab = "";
    private String pendingNotificationResourceId = "";
    private String pendingNotificationStoreId = "";
    private String pendingNotificationEventId = "";
    private FrameLayout shell;
    private LinearLayout root;
    private LinearLayout body;
    private LinearLayout drawer;
    private View drawerBackdrop;
    private TextView titleView;
    private TextView subtitleView;
    private TextView eyebrowView;
    private TextView storeTopbarView;
    private TextView userTopbarView;
    private boolean drawerOpen = false;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        Window window = getWindow();
        window.setStatusBarColor(PANEL_DARK);
        window.setNavigationBarColor(PANEL_DARK);
        api = new ApiClient();
        tokenStore = new SecureTokenStore(this);
        captureNotificationIntent(getIntent());
        bearer = tokenStore.load();
        if (bearer == null) {
            showLogin(null);
        } else {
            validateSession();
        }
    }

    @Override
    protected void onNewIntent(Intent intent) {
        super.onNewIntent(intent);
        setIntent(intent);
        captureNotificationIntent(intent);
        if (bearer != null && !bearer.trim().isEmpty() && body != null) {
            enterAuthenticatedRoute();
        }
    }

    @Override
    protected void onDestroy() {
        api.shutdown();
        super.onDestroy();
    }

    @Override
    public void onBackPressed() {
        if (drawerOpen) {
            closeDrawer();
            return;
        }
        super.onBackPressed();
    }

    private int dp(int value) {
        return Math.round(value * getResources().getDisplayMetrics().density);
    }

    private GradientDrawable rounded(int color, int strokeColor, int radius) {
        GradientDrawable drawable = new GradientDrawable();
        drawable.setColor(color);
        drawable.setCornerRadius(dp(radius));
        if (strokeColor != Color.TRANSPARENT) drawable.setStroke(dp(1), strokeColor);
        return drawable;
    }

    private TextView text(String value, int sp, int color, boolean bold) {
        TextView view = new TextView(this);
        view.setText(value == null ? "" : value);
        view.setTextSize(sp);
        view.setTextColor(color);
        view.setTypeface(Typeface.create("sans-serif", bold ? Typeface.BOLD : Typeface.NORMAL));
        view.setLineSpacing(0, 1.12f);
        return view;
    }

    private TextView eyebrow(String value) {
        TextView view = text(value == null ? "" : value.toUpperCase(Locale.ROOT), 11, ACCENT, true);
        view.setLetterSpacing(.16f);
        return view;
    }

    private Button button(String label, boolean primary) {
        Button button = new Button(this);
        button.setText(label);
        button.setTextSize(14);
        button.setAllCaps(false);
        button.setTypeface(Typeface.create("sans-serif", Typeface.BOLD));
        button.setTextColor(primary ? Color.WHITE : TEXT);
        button.setBackground(rounded(primary ? ACCENT : SURFACE, primary ? ACCENT : BORDER, 10));
        button.setPadding(dp(16), dp(9), dp(16), dp(9));
        button.setMinHeight(dp(46));
        button.setStateListAnimator(null);
        return button;
    }

    private View gap(int height) {
        Space gap = new Space(this);
        gap.setLayoutParams(new LinearLayout.LayoutParams(1, dp(height)));
        return gap;
    }

    private LinearLayout card() {
        LinearLayout card = new LinearLayout(this);
        card.setOrientation(LinearLayout.VERTICAL);
        card.setPadding(dp(16), dp(16), dp(16), dp(16));
        card.setBackground(rounded(SURFACE, BORDER, 12));
        card.setElevation(0);
        LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.WRAP_CONTENT
        );
        params.setMargins(0, 0, 0, dp(12));
        card.setLayoutParams(params);
        return card;
    }

    private String resolveUserAvatar(JSONObject user) {
        if (user == null) return "";
        String[] keys = new String[]{"avatar", "avatar_url", "photo", "photo_url", "image", "image_url"};
        for (String key : keys) {
            String value = user.optString(key, "").trim();
            if (!value.isEmpty() && !"null".equalsIgnoreCase(value)) return value;
        }
        return "";
    }

    private View userAvatarView(String name, String avatarSource, int size, int textSize) {
        FrameLayout frame = new FrameLayout(this);
        TextView fallback = text(name == null || name.trim().isEmpty() ? "D" : name.trim().substring(0, 1).toUpperCase(Locale.ROOT), textSize, Color.WHITE, true);
        fallback.setGravity(Gravity.CENTER);
        fallback.setBackground(rounded(Color.rgb(75, 77, 84), Color.rgb(91, 93, 101), 100));
        frame.addView(fallback, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));

        ImageView image = new ImageView(this);
        image.setScaleType(ImageView.ScaleType.CENTER_CROP);
        image.setBackground(rounded(Color.rgb(75, 77, 84), Color.TRANSPARENT, 100));
        image.setClipToOutline(true);
        image.setVisibility(View.GONE);
        frame.addView(image, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
        AvatarLoader.load(this, image, fallback, avatarSource);
        frame.setLayoutParams(new LinearLayout.LayoutParams(dp(size), dp(size)));
        return frame;
    }

    private void applyIdentity(JSONObject payload) {
        if (payload == null) return;
        JSONObject user = payload.optJSONObject("user");
        JSONObject store = payload.optJSONObject("store");
        if (user != null) {
            String name = user.optString("name", "").trim();
            if (!name.isEmpty()) currentUserName = name;
            String avatar = resolveUserAvatar(user);
            if (!avatar.isEmpty()) currentUserAvatar = avatar;
        }
        if (store != null) {
            String id = store.optString("id", "").trim();
            if (!id.isEmpty() && !"null".equalsIgnoreCase(id)) currentStoreId = id;
            String name = store.optString("name", "").trim();
            if (!name.isEmpty()) currentStoreName = name;
            String role = store.optString("role", "").trim();
            if (!role.isEmpty()) currentUserRole = role;
        }
        updateChromeIdentity();
    }

    private void updateChromeIdentity() {
        if (storeTopbarView != null) storeTopbarView.setText(currentStoreName);
        if (userTopbarView != null) userTopbarView.setText(currentUserName);
    }

    private void captureNotificationIntent(Intent intent) {
        if (intent == null) return;
        String tab = intent.getStringExtra(DezgreNotificationManager.EXTRA_ROUTE_TAB);
        if (!"orders".equals(tab) && !"connections".equals(tab)) return;
        pendingNotificationTab = tab;
        pendingNotificationResourceId = cleanExtra(intent.getStringExtra(DezgreNotificationManager.EXTRA_RESOURCE_ID));
        pendingNotificationStoreId = cleanExtra(intent.getStringExtra(DezgreNotificationManager.EXTRA_STORE_ID));
        pendingNotificationEventId = cleanExtra(intent.getStringExtra(DezgreNotificationManager.EXTRA_EVENT_ID));
    }

    private String cleanExtra(String value) {
        if (value == null) return "";
        String clean = value.trim();
        return "null".equalsIgnoreCase(clean) ? "" : clean;
    }

    private void enterAuthenticatedRoute() {
        String tab = pendingNotificationTab;
        String resourceId = pendingNotificationResourceId;
        String targetStoreId = pendingNotificationStoreId;
        clearPendingNotificationRoute();

        if (tab.isEmpty()) {
            showMain("home");
            return;
        }

        if (!targetStoreId.isEmpty() && !currentStoreId.isEmpty() && !targetStoreId.equals(currentStoreId)) {
            showMain("home");
            android.widget.Toast.makeText(
                    this,
                    "Esta notificación pertenece a otra tienda. Cambia a esa tienda antes de abrir el recurso.",
                    android.widget.Toast.LENGTH_LONG
            ).show();
            return;
        }

        showMain(tab);
        if ("orders".equals(tab) && !resourceId.isEmpty()) {
            loadOrderDetail(resourceId);
        }
    }

    private void clearPendingNotificationRoute() {
        pendingNotificationTab = "";
        pendingNotificationResourceId = "";
        pendingNotificationStoreId = "";
        pendingNotificationEventId = "";
    }

    private void validateSession() {
        setContentView(loadingScreen("Validando sesión segura…"));
        api.get("/me", bearer, new ApiClient.Callback() {
            @Override public void onSuccess(final JSONObject json) {
                runOnUiThread(new Runnable() {
                    @Override public void run() {
                        applyIdentity(json);
                        DezgreNotificationManager.requestPermission(MainActivity.this);
                        PushRegistrationCoordinator.ensureRegistered(MainActivity.this, bearer, null);
                        enterAuthenticatedRoute();
                    }
                });
            }
            @Override public void onError(final ApiClient.ApiException error) {
                runOnUiThread(new Runnable() {