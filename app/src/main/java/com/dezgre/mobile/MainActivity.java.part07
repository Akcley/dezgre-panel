
    private TextView profileField(String value, boolean mutedValue) {
        TextView field = text(value == null ? "" : value, 13, mutedValue ? MUTED : TEXT, !mutedValue);
        field.setGravity(Gravity.CENTER_VERTICAL);
        field.setPadding(dp(13), 0, dp(13), 0);
        field.setBackground(rounded(Color.rgb(252, 252, 253), BORDER, 9));
        field.setSingleLine(true);
        field.setEllipsize(android.text.TextUtils.TruncateAt.END);
        return field;
    }

    private void addProfileField(LinearLayout parent, String label, String value, boolean mutedValue) {
        parent.addView(text(label, 11, TEXT, true));
        parent.addView(gap(6));
        parent.addView(profileField(value, mutedValue), new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(48)));
        parent.addView(gap(12));
    }

    private String selectedStoreDomain(JSONObject current, JSONArray stores) {
        if (current != null) {
            String domain = current.optString("domain", "").trim();
            if (!domain.isEmpty() && !"null".equals(domain)) return domain;
        }
        if (stores != null) {
            for (int i = 0; i < stores.length(); i++) {
                JSONObject store = stores.optJSONObject(i);
                if (store == null || !store.optBoolean("selected", false)) continue;
                String domain = store.optString("domain", "").trim();
                if (!domain.isEmpty() && !"null".equals(domain)) return domain;
            }
        }
        return "";
    }

    private void renderProfile(JSONObject me, JSONArray stores) {
        body.removeAllViews();
        JSONObject user = me.optJSONObject("user");
        JSONObject current = me.optJSONObject("store");
        final String userName = user == null ? currentUserName : user.optString("name", currentUserName);
        final String email = user == null ? "" : user.optString("email", "");
        final String role = current == null ? currentUserRole : current.optString("role", currentUserRole);
        final String webDomain = selectedStoreDomain(current, stores);
        String profileAvatar = resolveUserAvatar(user);
        if (!profileAvatar.isEmpty()) currentUserAvatar = profileAvatar;

        LinearLayout accountCard = card();
        LinearLayout avatarBlock = new LinearLayout(this);
        avatarBlock.setOrientation(LinearLayout.HORIZONTAL);
        avatarBlock.setGravity(Gravity.CENTER_VERTICAL);
        avatarBlock.setPadding(dp(14), dp(14), dp(14), dp(14));
        avatarBlock.setBackground(rounded(Color.WHITE, BORDER, 12));

        avatarBlock.addView(userAvatarView(userName, currentUserAvatar, 64, 20));

        LinearLayout avatarCopy = new LinearLayout(this);
        avatarCopy.setOrientation(LinearLayout.VERTICAL);
        avatarCopy.setPadding(dp(14), 0, 0, 0);
        avatarCopy.addView(text("Foto de perfil", 13, TEXT, true));
        avatarCopy.addView(gap(4));
        avatarCopy.addView(text("Tu identidad de DEZGRE para esta tienda.", 11, MUTED, false));
        if (!role.isEmpty()) {
            avatarCopy.addView(gap(7));
            TextView roleBadge = text(role, 10, ACCENT, true);
            roleBadge.setPadding(dp(8), dp(4), dp(8), dp(4));
            roleBadge.setBackground(rounded(ACCENT_SOFT, Color.TRANSPARENT, 100));
            avatarCopy.addView(roleBadge, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT));
        }
        avatarBlock.addView(avatarCopy, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        accountCard.addView(avatarBlock);
        accountCard.addView(gap(18));

        addProfileField(accountCard, "Nombre", userName, false);
        addProfileField(accountCard, "Email", email, false);

        View divider = new View(this);
        divider.setBackgroundColor(BORDER);
        accountCard.addView(divider, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(1)));
        accountCard.addView(gap(16));
        accountCard.addView(text("Cambiar contraseña", 19, TEXT, false));
        accountCard.addView(gap(5));
        accountCard.addView(text("La edición segura de credenciales se realiza desde los ajustes completos de la cuenta.", 12, MUTED, false));
        accountCard.addView(gap(14));
        addProfileField(accountCard, "Contraseña actual", "Gestionar desde Ajustes de cuenta", true);
        addProfileField(accountCard, "Nueva contraseña", "Gestionar desde Ajustes de cuenta", true);
        addProfileField(accountCard, "Confirmar contraseña", "Gestionar desde Ajustes de cuenta", true);

        Button manageAccount = button("Editar foto, nombre o contraseña", true);
        manageAccount.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View v) {
                if (webDomain.isEmpty()) {
                    android.widget.Toast.makeText(MainActivity.this, "La tienda no devolvió todavía su dominio web.", android.widget.Toast.LENGTH_LONG).show();
                    return;
                }
                String url = webDomain.startsWith("http://") || webDomain.startsWith("https://")
                        ? webDomain
                        : "https://" + webDomain;
                android.content.Intent intent = new android.content.Intent(android.content.Intent.ACTION_VIEW,
                        android.net.Uri.parse(url + "/panel/cuenta"));
                startActivity(intent);
            }
        });
        accountCard.addView(manageAccount, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(50)));
        body.addView(accountCard);

        LinearLayout accessCard = card();
        accessCard.addView(eyebrow("TIENDAS CON ACCESO"));
        accessCard.addView(gap(11));
        if (stores != null && stores.length() > 0) {
            for (int i = 0; i < stores.length(); i++) {
                JSONObject store = stores.optJSONObject(i);
                if (store == null) continue;
                boolean selected = store.optBoolean("selected", false);
                LinearLayout line = new LinearLayout(this);
                line.setOrientation(LinearLayout.HORIZONTAL);
                line.setGravity(Gravity.CENTER_VERTICAL);
                TextView dot = text("●", 12, selected ? ACCENT : Color.rgb(205, 208, 216), true);
                line.addView(dot, new LinearLayout.LayoutParams(dp(24), ViewGroup.LayoutParams.WRAP_CONTENT));
                LinearLayout storeCopy = new LinearLayout(this);
                storeCopy.setOrientation(LinearLayout.VERTICAL);
                storeCopy.addView(text(store.optString("name", "Tienda"), 14, TEXT, true));
                storeCopy.addView(gap(2));
                storeCopy.addView(text(store.optString("role", ""), 10, MUTED, false));
                line.addView(storeCopy, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
                if (selected) {
                    TextView active = text("ACTUAL", 9, ACCENT, true);
                    active.setPadding(dp(8), dp(4), dp(8), dp(4));
                    active.setBackground(rounded(ACCENT_SOFT, Color.TRANSPARENT, 100));
                    line.addView(active);
                }
                accessCard.addView(line);
                if (i < stores.length() - 1) {
                    accessCard.addView(gap(10));
                    View rowDivider = new View(this);
                    rowDivider.setBackgroundColor(BORDER);
                    accessCard.addView(rowDivider, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(1)));
                    accessCard.addView(gap(10));
                }
            }
        } else {
            accessCard.addView(text(currentStoreName, 14, TEXT, true));
        }
        body.addView(accessCard);

        final String notificationStoreId = current == null ? "current" : current.optString("id", "current");
        LinearLayout notificationCard = card();
        notificationCard.addView(eyebrow("NOTIFICACIONES"));
        notificationCard.addView(gap(7));
        notificationCard.addView(text("Avisos de DEZGRE", 18, TEXT, true));
        notificationCard.addView(gap(5));
        notificationCard.addView(text("Controla el permiso de Android y prueba el sonido de las notificaciones en este teléfono.", 12, MUTED, false));
        notificationCard.addView(gap(14));

        LinearLayout notifRow = new LinearLayout(this);
        notifRow.setOrientation(LinearLayout.HORIZONTAL);
        notifRow.setGravity(Gravity.CENTER_VERTICAL);
        TextView bell = text("●", 16, ACCENT, true);
        bell.setGravity(Gravity.CENTER);
        bell.setBackground(rounded(ACCENT_SOFT, Color.TRANSPARENT, 10));
        notifRow.addView(bell, new LinearLayout.LayoutParams(dp(42), dp(42)));
        LinearLayout notifCopy = new LinearLayout(this);
        notifCopy.setOrientation(LinearLayout.VERTICAL);
        notifCopy.setPadding(dp(11), 0, 0, 0);
        notifCopy.addView(text("Notificaciones del dispositivo", 13, TEXT, true));
        notifCopy.addView(gap(2));
        notifCopy.addView(text("Permiso: " + DezgreNotificationManager.permissionLabel(this), 11,
                DezgreNotificationManager.hasPermission(this) ? SUCCESS : MUTED, false));
        notifRow.addView(notifCopy, new LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f));
        notificationCard.addView(notifRow);
        notificationCard.addView(gap(12));

        final TextView notificationStatus = text(
                "Usa esta prueba para comprobar que Android reproduce sonido y vibración.",
                11, MUTED, false);
        notificationCard.addView(notificationStatus);
        notificationCard.addView(gap(10));
        Button testNotification = button(
                DezgreNotificationManager.hasPermission(this) ? "Probar sonido y notificación" : "Activar notificaciones",
                false
        );
        testNotification.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View v) {
                boolean shown = DezgreNotificationManager.showTest(MainActivity.this, notificationStoreId);
                if (shown) {
                    notificationStatus.setText("Prueba enviada. Debe escucharse y vibrar si el teléfono tiene activo el volumen de notificaciones.");
                    notificationStatus.setTextColor(SUCCESS);
                } else {
                    notificationStatus.setText("Android solicitó permiso. Acéptalo y vuelve a tocar la prueba.");
                    notificationStatus.setTextColor(MUTED);
                }
            }
        });
        notificationCard.addView(testNotification);
        body.addView(notificationCard);

        LinearLayout sessionCard = card();
        Button logout = button("Cerrar sesión en este dispositivo", false);
        logout.setTextColor(DANGER);
        logout.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View v) {
                tokenStore.clear();
                bearer = null;
                currentUserAvatar = "";
                showLogin(null);
            }
        });
        sessionCard.addView(logout, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(50)));
        body.addView(sessionCard);
        body.addView(gap(8));

        String versionName = "0.1.3-preview";
        long versionCode = 0;
        try {
            android.content.pm.PackageInfo info = getPackageManager().getPackageInfo(getPackageName(), 0);
            if (info.versionName != null && !info.versionName.trim().isEmpty()) versionName = info.versionName;
            if (android.os.Build.VERSION.SDK_INT >= 28) {
                versionCode = info.getLongVersionCode();
            } else {
                versionCode = info.versionCode;
            }
        } catch (Exception ignored) {}
        TextView version = text("DEZGRE Mobile " + versionName + " · build " + versionCode, 10, MUTED, false);
        version.setGravity(Gravity.CENTER);
        body.addView(version);
    }

    private void handlePrivateError(final ApiClient.ApiException error, final String fallback) {
        runOnUiThread(new Runnable() {
            @Override public void run() {
                if (error.status == 401 || error.status == 403) {
                    tokenStore.clear();
                    bearer = null;
                    currentUserAvatar = "";
                    showLogin("Tu sesión expiró o ya no tiene acceso.");
                    return;
                }
                if (body != null) {
                    body.removeAllViews();
                    LinearLayout errorCard = card();
                    errorCard.addView(text(fallback, 17, DANGER, true));
                    errorCard.addView(gap(6));
                    errorCard.addView(text(error.getMessage(), 13, MUTED, false));
                    body.addView(errorCard);
                    Button retry = button("Reintentar", true);
                    retry.setOnClickListener(new View.OnClickListener() {
                        @Override public void onClick(View v) { showMain(currentTab); }
                    });
                    body.addView(retry);
                }
            }
        });
    }

    private void hideKeyboard() {
        try {
            View focus = getCurrentFocus();
            if (focus != null) {
                InputMethodManager manager = (InputMethodManager) getSystemService(Context.INPUT_METHOD_SERVICE);
                manager.hideSoftInputFromWindow(focus.getWindowToken(), 0);
            }
        } catch (Exception ignored) {}
    }